# Copy this file to device.env and edit it on the Raspberry Pi.

# AWS IoT endpoints for the same AWS account/region configured in SORACOM Krypton.
AWS_REGION="ap-northeast-1"
AWS_IOT_DATA_ENDPOINT="xxxxxxxxxxxxxx-ats.iot.ap-northeast-1.amazonaws.com"
AWS_IOT_CRED_ENDPOINT="xxxxxxxxxxxxxx.credentials.iot.ap-northeast-1.amazonaws.com"

# Existing AWS IoT role alias for Greengrass token exchange.
GREENGRASS_ROLE_ALIAS="GreengrassV2TokenExchangeCoreDeviceRoleAlias"

# SORACOM Air APN settings.
SORACOM_APN="soracom.io"
SORACOM_USERNAME="sora"
SORACOM_PASSWORD="sora"

# Set this when multiple cellular interfaces exist. Leave auto to try wwan* interfaces.
SORACOM_IFACE="auto"

# Local paths.
KRYPTON_CERT_DIR="/opt/soracom-krypton/aws-iot"
GREENGRASS_ROOT="/greengrass/v2"

# Use latest Greengrass Nucleus zip from AWS.
GREENGRASS_NUCLEUS_ZIP_URL="https://d2s8p88vqu9w66.cloudfront.net/releases/greengrass-nucleus-latest.zip"

